{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "BNCAuth": "",
    "ExceptionDB": ""
  },
  "RepositorySettings": {
    "BNCAuth": {
      "StoredProcedures": {
        "GetUserPermissions": "[Auth].[p_API_UserPermissions_Get]",
        "GetUserRoles": "[Auth].[p_API_UserRole_GetByUser]",
        "SaveAccessToken": "[Auth].[p_API_AccessToken_Insert]",
        "InsertUser": "[Auth].[p_API_User_Insert]",
        "UpdateUser": "[Auth].[p_API_User_Update]",
        "ListUsers": "[Auth].[p_API_User_List]",
        "InsertService": "[Auth].[p_API_Service_Insert]",
        "UpdateService": "[Auth].[p_API_Service_Update]",
        "ListServices": "[Auth].[p_API_Service_List]",
        "InsertEndpoint": "[Auth].[p_API_Endpoint_Insert]",
        "UpdateEndpoint": "[Auth].[p_API_Endpoint_Update]",
        "ListEndpointsByService": "[Auth].[p_API_Endpoint_ListByService]",
        "InsertPermission": "[Auth].[p_API_Permission_Insert]",
        "UpdatePermission": "[Auth].[p_API_Permission_Update]",
        "ListPermissionsByUser": "[Auth].[p_API_Permission_ListByUser]",
        "InsertRole": "[Auth].[p_API_Role_Insert]",
        "UpdateRole": "[Auth].[p_API_Role_Update]",
        "ListRoles": "[Auth].[p_API_Role_List]",
        "AssignUserRole": "[Auth].[p_API_UserRole_Insert]",
        "UpdateUserRole": "[Auth].[p_API_UserRole_Update]",
        "ListUserRolesByUser": "[Auth].[p_API_UserRole_ListByUser]"
      }
    }
  },
  "Jwt": {
    "Issuer": "BNC.MsAuth",
    "Audience": "BNC.Microservices",
    "SigningKey": "",
    "LifetimeHours": 24
  }
}
